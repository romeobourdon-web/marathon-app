{
  "name": "target-42",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local --import ./scripts/register-paths.mjs scripts/seed.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/db/database.types.ts",
    "sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local --import ./scripts/register-paths.mjs scripts/sync.ts",
    "db:backup": "mkdir -p backups && f=backups/$(date +%F).sql && if [ -e \"$f\" ]; then f=backups/$(date +%F-%H%M%S).sql; fi && supabase db dump --data-only --schema public,auth -f \"$f\"",
    "app": "node scripts/app.mjs"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.221.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
